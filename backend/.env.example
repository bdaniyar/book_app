# Runtime
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://book_app:book_app@localhost:5432/book_app
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGINS=http://localhost:3000

# Authentication cookies
REFRESH_COOKIE_NAME=book_app_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Tests: this must be a separate, disposable database.
TEST_DATABASE_URL=postgresql+psycopg://book_app:book_app@localhost:5432/book_app_test

# AI assistant. "local" works without external services; use "openai" in production.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=900

# Optional SQLAdmin. Keep disabled unless a separate session secret is configured.
ADMIN_ENABLED=false
ADMIN_SESSION_SECRET_KEY=
ADMIN_SESSION_COOKIE_SECURE=false

# Password reset / SMTP
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
DEV_EMAIL_OUTPUT=true
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
